NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app. Used to build absolute redirect URLs
# for the Supabase Auth magic link callback. In dev, point it at the
# local server (e.g. http://127.0.0.1:3000); in prod, use the deployed
# origin (e.g. https://investment-tracker.vercel.app).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only. Shared secret that allows the Supabase Edge Functions
# (sync-prices, sync-fx-rates) to invalidate the Next.js cache tags
# ("market-prices", "benchmark") via POST /api/v1/admin/cache/invalidate.
# Generate with: openssl rand -hex 32
ADMIN_CACHE_TOKEN=

# Supabase Auth setup checklist (manual, one-time per project):
# 1. Authentication > Providers > Email: enabled (default).
# 2. Authentication > URL Configuration:
#    - Site URL: $NEXT_PUBLIC_SITE_URL
#    - Additional Redirect URLs: $NEXT_PUBLIC_SITE_URL/auth/callback
# 3. Authentication > Email Templates > Magic link: customize the
#    sender name if desired. Free tier SMTP sends a few emails/hour.
# 4. To wipe any orphan portfolios from the MVP before re-testing:
#      delete from public.portfolios where user_id is null;
